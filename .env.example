# Optional. If unset, `drassos dev` uses a local PGlite (Postgres-compatible) data directory.
# DATABASE_URL=postgres://drassos:drassos@localhost:5432/drassos

DRASSOS_PORT=3100
DRASSOS_DATA_DIR=.drassos
DRASSOS_LOG_LEVEL=info
DRASSOS_LEASE_MS=30000

# Optional. When set, agent steps use the OpenAI-compatible provider.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
