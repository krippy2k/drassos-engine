{
  "name": "@drassos/engine",
  "version": "0.10.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Drassos runtime implementation used by @drassos/node.",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "pack:pkg": "pnpm pack"
  },
  "dependencies": {
    "@drassos/core": "workspace:*",
    "@electric-sql/pglite": "^0.3.14",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
